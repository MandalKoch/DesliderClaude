@inherits LayoutComponentBase
@inject NavigationManager Nav

<a class="skip-link" href="@(Nav.Uri.Split('#')[0] + "#main-content")">Skip to content</a>

<header class="app-header">
    <a class="app-brand" href="/">
        <svg class="table-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
            <g transform="rotate(-12 14.5 14.5)" opacity=".55">
                <rect x="3" y="3" width="23" height="23" rx="5" fill="currentColor" />
                <g fill="var(--bg-0)"><circle cx="8.5" cy="8.5" r="1.8" /><circle cx="14.5" cy="14.5" r="1.8" /><circle cx="20.5" cy="20.5" r="1.8" /></g>
            </g>
            <g transform="rotate(8 24.5 25.5)">
                <rect x="13" y="14" width="23" height="23" rx="5" fill="currentColor" />
                <g fill="var(--bg-0)"><circle cx="19" cy="20" r="1.8" /><circle cx="30" cy="20" r="1.8" /><circle cx="24.5" cy="25.5" r="1.8" /><circle cx="19" cy="31" r="1.8" /><circle cx="30" cy="31" r="1.8" /></g>
            </g>
        </svg>
        <span><span class="name">Deslider</span><span class="name-dim">Claude</span></span>
    </a>
    <nav class="app-nav" aria-label="Main navigation">
        <a class="app-nav-link" href="/">Your table</a>
        <AuthorizeView>
            <Authorized>
                <a class="app-nav-link is-signed-in" href="/account">
                    <svg class="app-nav-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="8" cy="5.5" r="2.75" stroke="currentColor" stroke-width="1.4" />
                        <path d="M2.5 13.5c0-2.5 2.5-4.25 5.5-4.25s5.5 1.75 5.5 4.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                    <span>Account</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="app-nav-link" href="/signin">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main class="page" id="main-content">
    @Body
</main>

<footer class="footer-meta">
    <span>Less organising. More playing.</span>
    <span>Made for your table.</span>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    System error
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>
