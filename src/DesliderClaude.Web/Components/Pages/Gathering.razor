@page "/gathering/{ShareCode}"
@page "/gathering/{ShareCode}/games"
@using System.Security.Cryptography
@using DesliderClaude.Core.Models
@using DesliderClaude.Core.Services
@inject IGatheringService Gatherings
@inject IBggImportService Libraries
@inject NavigationManager Nav

<PageTitle>@(IsPicker ? "Add games — " : "")@(_gathering?.Name ?? "Gathering") — DesliderClaude</PageTitle>

<div class="gathering-page">
@if (_gathering is null)
{
    <h1>Gathering not found.</h1><p><a href="/">Return to your table</a></p>
}
else
{
    <a class="back-link" href="@(IsPicker ? GatheringUrl : "/")">← @(IsPicker ? _gathering.Name : "Your table")</a>
    <header class="gathering-header">
        <div><span class="eyebrow">Good company. Great games.</span><h1>@(IsPicker ? "Add to the table." : _gathering.Name)</h1></div>
        <span class="people-count">@_gathering.Members.Count people · @_gathering.Games.Count games</span>
    </header>
    @if (_member is null)
    {
        <section class="panel join-panel">
            <h2>Pull up a chair.</h2><p>Join once to add your games and vote on what to play.</p>
            <form method="post" @formname="gathering-join" @onsubmit="HandleAsync">
                <AntiforgeryToken />@PickerState<input type="hidden" name="Form.Action" value="join" />
                <label for="member-name">Your name</label><input id="member-name" name="Form.DisplayName" value="@Form?.DisplayName" maxlength="40" autocomplete="nickname" required />
                <button class="btn btn-primary" type="submit">Join gathering</button>
            </form>
        </section>
    }
    else
    {
        <p class="member-greeting">You're here as <strong>@_member.DisplayName</strong>@(_isHost ? " · You're hosting" : "")</p>
    }
    <div class="feedback-region" aria-live="polite">
        @if (_error is not null) { <p class="text-danger feedback" role="alert">@_error</p> }
        @if (_notice is not null) { <p class="text-ok feedback" role="status">@_notice</p> }
    </div>
    @if (IsPicker)
    {
        @if (_gathering.IsVotingClosed)
        {
            <div class="panel"><h2>The table is set.</h2><p>The host has closed voting. Games can be added again when voting reopens.</p><a href="@GatheringUrl">See the games →</a></div>
        }
        else if (_member is not null)
        {
            <p class="section-intro">Choose games you can bring. Each one goes straight onto the shared table.</p>
            <div class="panel add-panel">
                <form method="post" @formname="gathering-add-game" @onsubmit="HandleAsync" data-enhance>
                    <AntiforgeryToken />
                    <input type="hidden" name="Form.HasPickerState" value="true" />
                    <input type="hidden" name="Form.LibraryId" value="@LibraryId" />
                    <input type="hidden" name="Form.BrowseSource" value="@ActiveSource" />
                    <input type="hidden" name="Form.Players" value="@Players" />
                    <input type="hidden" name="Form.MaxMinutes" value="@MaxMinutes" />
                    <label for="game-name">Suggest a game you can bring</label>
                    <input id="game-name" name="Form.SearchQuery" value="@SearchQuery" maxlength="200" placeholder="e.g. Cascadia" required />
                    <div class="suggestion-actions"><button class="btn btn-primary" type="submit" name="Form.Action" value="search-bgg">Search on BGG</button><button class="btn btn-ghost" type="submit" name="Form.Action" value="add-game">Add as text</button></div>
                </form>
            </div>
            <section id="choose-games" class="library-browser panel" aria-labelledby="library-title">
                <h3 id="library-title">Choose more games</h3>
                <p class="hint">Browse your library or search BoardGameGeek. Tap a game to add it to the shared table.</p>
                <form method="post" @formname="gathering-browse" @onsubmit="HandleAsync" class="browse-form" data-enhance>
                    <AntiforgeryToken />
                    <input type="hidden" name="Form.HasPickerState" value="true" />
                    <input type="hidden" name="Form.BrowseSource" value="@ActiveSource" />
                    <input type="hidden" name="Form.SearchQuery" value="@SearchQuery" />
                    @if (_libraries.Count > 0)
                    {
                        <label for="library-source">Your library</label>
                        <div class="input-action"><select id="library-source" name="Form.LibraryId"><option value="">Choose a library…</option>@foreach (var library in _libraries) { <option value="@library.Id" selected="@(LibraryId == library.Id)">@library.Name</option> }</select><button class="btn btn-ghost" name="Form.Action" value="browse-library" type="submit">Browse library</button></div>
                    }
                    <details class="picker-filters" open="@(!string.IsNullOrWhiteSpace(Players) || !string.IsNullOrWhiteSpace(MaxMinutes) || Form?.Action is "filter-games" or "clear-filters")">
                        <summary>Narrow it down <span class="hint">optional</span></summary>
                        <div class="picker-filter-grid">
                            <div><label for="picker-players">How many players?</label><input id="picker-players" name="Form.Players" type="number" min="1" max="99" value="@Players" placeholder="Any number" /></div>
                            <div><label for="picker-time">Up to how many minutes?</label><input id="picker-time" name="Form.MaxMinutes" type="number" min="1" max="999" value="@MaxMinutes" placeholder="Any length" /></div>
                        </div>
                        <p class="hint">Filters only change available games. Games already on the table stay there.</p>
                        <div class="interest-actions"><button class="btn btn-ghost btn-sm" type="submit" name="Form.Action" value="filter-games">Apply filters</button><button class="btn btn-ghost btn-sm" type="submit" name="Form.Action" value="clear-filters">Clear filters</button></div>
                    </details>
                </form>
                @if (_pickerError is not null)
                {
                    <p class="text-danger" role="alert">@_pickerError You can use Add as text with the same name above.</p>
                }
                else if (HasBrowseSource)
                {
                    var available = _libraryGames.Where(IsAvailable).ToList();
                    <p class="available-count">@available.Count games available</p>
                    @if (available.Count == 0) { <p class="hint">No more games match. Try another search or clear the filters.</p> }
                    <form method="post" @formname="gathering-library-game" @onsubmit="HandleAsync" data-enhance>
                        <AntiforgeryToken />@PickerState<input type="hidden" name="Form.Action" value="add-library-game" />
                        <ul class="candidate-list">
                            @foreach (var game in available)
                            {
                                <li class="candidate-row">
                                    <button class="library-game unstyled" type="submit" name="Form.BggGameId" value="@game.BggGameId" aria-label="@($"Add {game.Name} to gathering")">
                                        @if (!string.IsNullOrEmpty(game.ThumbnailUrl)) { <img class="candidate-thumb" src="@game.ThumbnailUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }
                                        <span class="candidate-main"><span class="candidate-name">@game.Name</span><span class="candidate-meta">@FormatRange(game.MinPlayers, game.MaxPlayers) players · @FormatRange(game.MinPlayTimeMinutes, game.MaxPlayTimeMinutes) min</span></span><span class="add-game-label" aria-hidden="true">＋ Add</span>
                                    </button>
                                    <a class="bgg-link" href="@($"https://boardgamegeek.com/boardgame/{game.BggGameId}")" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {game.Name} on BoardGameGeek")">Open on BGG ↗</a>
                                </li>
                            }
                        </ul>
                    </form>
                }
            </section>
        }
    }
    else
    {
        @if (!_gathering.IsVotingClosed) { <p class="open-status">Voting open · Everyone can add games and vote.</p> }
        <div class="table-actions">
            @if (_gathering.IsVotingClosed)
            {
                <span class="voting-status">Voting closed · Here's the group's pick</span>
            }
            else if (_member is not null)
            {
                <a class="btn btn-primary" href="@($"{GatheringUrl}/vote")">Vote on games →</a>
                <a class="btn btn-ghost" href="@($"{GatheringUrl}/games")">＋ Add games</a>
            }
            <details class="invite-details"><summary>Invite friends</summary><label for="gathering-link">Share this gathering</label><input id="gathering-link" readonly value="@Nav.ToAbsoluteUri(GatheringUrl)" onclick="this.select()" /><button class="btn btn-ghost btn-sm" type="button" onclick="navigator.clipboard.writeText(document.getElementById('gathering-link').value).then(()=>this.textContent='Link copied').catch(()=>this.textContent='Select and copy the link');">Copy invite link</button></details>
        </div>
        <section id="games" class="table-games" aria-labelledby="games-heading">
            <div class="section-heading"><div><span class="eyebrow">Everyone's favourites, together</span><h2 id="games-heading">On the table.</h2></div><span>@_gathering.Games.Count games</span></div>
            @if (_gathering.Games.Count == 0)
            {
                <div class="empty-state"><span aria-hidden="true">＋</span><h3>Room for your favourites.</h3><p>Add the games you're bringing, then invite your friends to do the same.</p>@if (_member is not null && !_gathering.IsVotingClosed) { <a href="@($"{GatheringUrl}/games")">Add the first game →</a> }</div>
            }
            else
            {
                <ul class="cover-grid">
                @foreach (var game in _gathering.Games.OrderByDescending(g => g.Interests.Count(i => i.Interested)).ThenBy(g => g.Name))
                {
                    var used = game.IsUsedInVote || _gathering.PlayedGames.Any(p => p.GatheringGameId == game.Id);
                    <li class="cover-card">
                        <div class="cover-art">@if (!string.IsNullOrEmpty(game.ImageUrl ?? game.ThumbnailUrl)) { <img src="@(game.ImageUrl ?? game.ThumbnailUrl)" alt="" loading="lazy" referrerpolicy="no-referrer" /> } else { <span aria-hidden="true">@game.Name[..1]</span> }</div>
                        <div class="cover-copy"><h3>@game.Name</h3><p>@MemberName(game.BringerMemberId ?? game.SuggestedByMemberId) brings this</p><span class="interest-total">@game.Interests.Count(i => i.Interested) want to play</span></div>
                        @if (!_gathering.IsVotingClosed && _member is not null && (_isHost || game.SuggestedByMemberId == _member.Id))
                        {
                            <details class="game-options"><summary aria-label="@($"Options for {game.Name}")">•••</summary><form method="post" @formname="@($"remove-game-{game.Id}")" @onsubmit="HandleAsync" data-enhance><AntiforgeryToken /><input type="hidden" name="Form.GameId" value="@game.Id" /><button class="btn btn-ghost btn-sm" name="Form.Action" value="remove-game" disabled="@used" aria-label="@($"Remove {game.Name} from gathering")">Remove game</button>@if (used) { <span class="hint">Kept in played and vote history.</span> }</form></details>
                        }
                    </li>
                }
                </ul>
            }
        </section>
        @if (_member is not null)
        {
            <a class="my-votes-link" href="@($"{GatheringUrl}/vote#my-votes")">Review my votes →</a>
        }
        @if (_isHost)
        {
            <details class="host-options"><summary>Host controls</summary><p class="hint">Close voting when everyone's had their say. Reopen it to add games and collect more votes.</p><form method="post" @formname="gathering-voting-state" @onsubmit="HandleAsync" data-enhance><AntiforgeryToken /><button class="btn btn-ghost" name="Form.Action" value="@(_gathering.IsVotingClosed ? "reopen-voting" : "close-voting")">@(_gathering.IsVotingClosed ? "Reopen voting" : "Close voting")</button></form>
            @if (_gathering.Games.Any(g => g.IsConfirmed))
            {
                <form method="post" @formname="gathering-played" @onsubmit="HandleAsync" class="played-form" data-enhance><AntiforgeryToken /><input type="hidden" name="Form.Action" value="mark-played" /><label for="played-game">What did you play?</label><div class="input-action"><select id="played-game" name="Form.GameId">@foreach (var game in _gathering.Games.Where(g => g.IsConfirmed).OrderBy(g => g.Name)) { <option value="@game.Id">@game.Name</option> }</select><button class="btn btn-ghost" type="submit">Mark as played</button></div></form>
            }
            </details>
        }
        @if (_gathering.PlayedGames.Count > 0 || _gathering.Rounds.Count > 0)
        {
            <details class="table-history"><summary>Around this table · History</summary><ol class="history-list">@foreach (var played in _gathering.PlayedGames.OrderByDescending(p => p.PlayedAt)) { <li><strong>@played.GameName</strong><time datetime="@played.PlayedAt.ToString("O")">@played.PlayedAt.ToString("MMM d, HH:mm") UTC</time></li> }</ol>
            @if (_gathering.Rounds.Count > 0) { <h3>Earlier game votes</h3><ul class="round-list">@foreach (var round in _gathering.Rounds.OrderByDescending(r => r.CreatedAt)) { <li><strong>@round.Name</strong><a href="/night/@round.ShareCode/winner">Results →</a>@if (_isHost) { <a href="/night/@round.ShareCode/host">Manage</a> }</li> }</ul> }
            </details>
        }
    }
}
</div>

@code {
    [Parameter] public string ShareCode { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "library")] public Guid? LibraryId { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? BrowseSource { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "players")] public string? Players { get; set; }
    [SupplyParameterFromQuery(Name = "minutes")] public string? MaxMinutes { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromForm] public GatheringForm? Form { get; set; }
    private GatheringView? _gathering;
    private GatheringMemberView? _member;
    private Guid? _userId;
    private string? _memberToken;
    private bool _isHost;
    private string? _error;
    private string? _notice;
    private string? _pickerError;
    private IReadOnlyList<BggImportView> _libraries = Array.Empty<BggImportView>();
    private IReadOnlyList<BggCandidateGame> _libraryGames = Array.Empty<BggCandidateGame>();
    private bool IsPicker => Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/games", StringComparison.Ordinal);
    private string GatheringUrl => $"/gathering/{ShareCode}";
    private string CookieName => $"deslider-gathering-{ShareCode}";

    protected override async Task OnInitializedAsync()
    {
        if (Form?.HasPickerState == true)
        {
            LibraryId = Form.LibraryId;
            BrowseSource = Form.BrowseSource;
            SearchQuery = Form.SearchQuery;
            Players = Form.Players;
            MaxMinutes = Form.MaxMinutes;
        }
        _gathering = await Gatherings.GetByShareCodeAsync(ShareCode);
        if (_gathering is null || HttpContext is null) return;
        var user = AuthState is null ? null : (await AuthState).User;
        _userId = user?.GetUserId();
        _isHost = _userId is not null && _gathering.CreatedByUserId == _userId;
        _memberToken = HttpContext.Request.Cookies[CookieName];
        if (_memberToken is not null) _member = await Gatherings.GetMemberAsync(_gathering.Id, _memberToken);
        if (_member is null && _userId is not null && !string.IsNullOrEmpty(user?.GetUsername()))
        {
            _memberToken = NewToken();
            _member = await Gatherings.JoinAsync(_gathering.Id, user.GetUsername()!, _memberToken, _userId);
            SetMemberCookie();
            _gathering = await Gatherings.GetByShareCodeAsync(ShareCode);
        }
        if (IsPicker)
        {
            if (_userId is Guid userId) _libraries = await Libraries.ListForUserAsync(userId);
            if (Form?.Action is not ("add-game" or "search-bgg")) await LoadPickerAsync();
        }
    }

    private async Task LoadPickerAsync()
    {
        _libraryGames = Array.Empty<BggCandidateGame>();
        _pickerError = null;
        if (_member is null) return;
        try
        {
            if (ActiveSource == "search" && !string.IsNullOrWhiteSpace(SearchQuery))
                _libraryGames = await Libraries.SearchGamesAsync(SearchQuery);
            else if (LibraryId is Guid libraryId && _userId is Guid uid && _libraries.Any(l => l.Id == libraryId))
                _libraryGames = await Libraries.ListCandidatesAsync(uid, new[] { libraryId });
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or ArgumentException or TaskCanceledException or System.Xml.XmlException)
        {
            _pickerError = "Couldn't load games from BoardGameGeek.";
        }
    }

    private async Task HandleAsync()
    {
        if (_gathering is null || HttpContext is null) return;
        try
        {
            switch (Form?.Action)
            {
                case "close-voting" or "reopen-voting" when _isHost && _userId is Guid votingHost:
                    await Gatherings.SetVotingClosedAsync(_gathering.Id, votingHost, Form.Action == "close-voting");
                    _notice = Form.Action == "close-voting" ? "Voting closed." : "Voting reopened. Everyone can add games and vote again.";
                    break;
                case "browse-library":
                    BrowseSource = "library";
                    await LoadPickerAsync();
                    return;
                case "search-bgg":
                    BrowseSource = "search";
                    await LoadPickerAsync();
                    return;
                case "filter-games":
                    await LoadPickerAsync();
                    return;
                case "clear-filters":
                    Players = MaxMinutes = null;
                    await LoadPickerAsync();
                    return;
                case "join":
                    _memberToken = NewToken();
                    _member = await Gatherings.JoinAsync(_gathering.Id, Form.DisplayName ?? string.Empty, _memberToken, _userId);
                    SetMemberCookie();
                    Nav.NavigateTo(IsPicker ? $"{GatheringUrl}/games" : GatheringUrl);
                    return;
                case "add-game" when _member is not null && _memberToken is not null:
                    await Gatherings.AddGameAsync(_gathering.Id, _memberToken, new GameCandidate(Form.SearchQuery ?? string.Empty));
                    _notice = "Game added to the table. Friends can now vote on it.";
                    SearchQuery = null;
                    await LoadPickerAsync();
                    break;
                case "add-library-game" when _member is not null && _memberToken is not null:
                    var candidate = _libraryGames.FirstOrDefault(g => g.BggGameId == Form.BggGameId && IsAvailable(g))
                        ?? throw new InvalidOperationException("Choose a game from your library first.");
                    if (ActiveSource == "search") candidate = await Libraries.GetGameAsync(candidate.BggGameId);
                    await Gatherings.AddGameAsync(_gathering.Id, _memberToken, new GameCandidate(candidate.Name, candidate.BggGameId, candidate.ImageUrl, candidate.ThumbnailUrl));
                    _notice = "Game added to this gathering.";
                    break;
                case "remove-game" when _member is not null && _memberToken is not null && Form.GameId is Guid removeId:
                    await Gatherings.RemoveGameAsync(_gathering.Id, _memberToken, removeId, _userId);
                    _notice = "Game removed from the table. You can add it again from the available games.";
                    break;
                case "mark-played" when _isHost && _userId is Guid playedHost && Form.GameId is Guid playedId:
                    await Gatherings.MarkPlayedAsync(_gathering.Id, playedHost, playedId);
                    _notice = "Added to your played history.";
                    break;
                default:
                    throw new InvalidOperationException("Join the gathering before taking part.");
            }
            _gathering = await Gatherings.GetByShareCodeAsync(ShareCode);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException or System.Xml.XmlException)
        {
            _error = ex is HttpRequestException or TaskCanceledException or System.Xml.XmlException
                ? "Couldn't load this game from BoardGameGeek. Try again, or add its name manually."
                : ex.Message;
        }
    }

    private RenderFragment PickerState => @<text>
        <input type="hidden" name="Form.HasPickerState" value="true" />
        <input type="hidden" name="Form.LibraryId" value="@LibraryId" />
        <input type="hidden" name="Form.BrowseSource" value="@ActiveSource" />
        <input type="hidden" name="Form.SearchQuery" value="@SearchQuery" />
        <input type="hidden" name="Form.Players" value="@Players" />
        <input type="hidden" name="Form.MaxMinutes" value="@MaxMinutes" />
    </text>;

    private string ActiveSource => BrowseSource == "search" || LibraryId is null ? "search" : "library";
    private bool HasBrowseSource => ActiveSource == "search" ? !string.IsNullOrWhiteSpace(SearchQuery) : LibraryId is not null;

    private bool IsAvailable(BggCandidateGame game)
    {
        if (_gathering!.Games.Any(g => g.BggGameId == game.BggGameId || string.Equals(g.Name.Trim(), game.Name.Trim(), StringComparison.OrdinalIgnoreCase))) return false;
        if (int.TryParse(Players, out var players) && players > 0 && (game.MinPlayers is null || game.MaxPlayers is null || game.MinPlayers > players || game.MaxPlayers < players)) return false;
        if (int.TryParse(MaxMinutes, out var minutes) && minutes > 0 && (game.MaxPlayTimeMinutes is null || game.MaxPlayTimeMinutes > minutes)) return false;
        return true;
    }

    private static string FormatRange(int? min, int? max)
        => min is null && max is null ? "?" : min == max ? min.ToString()! : $"{min?.ToString() ?? "?"}–{max?.ToString() ?? "?"}";

    private string MemberName(Guid id) => _gathering?.Members.FirstOrDefault(m => m.Id == id)?.DisplayName ?? "Someone";
    private static string NewToken() => Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
    private void SetMemberCookie() => HttpContext!.Response.Cookies.Append(CookieName, _memberToken!, new CookieOptions
    {
        HttpOnly = true, Secure = HttpContext.Request.IsHttps, IsEssential = true,
        SameSite = SameSiteMode.Lax, MaxAge = TimeSpan.FromDays(60), Path = "/"
    });

    public sealed class GatheringForm
    {
        public string? Action { get; set; }
        public bool HasPickerState { get; set; }
        public Guid? LibraryId { get; set; }
        public string? BrowseSource { get; set; }
        public string? SearchQuery { get; set; }
        public string? Players { get; set; }
        public string? MaxMinutes { get; set; }
        public string? DisplayName { get; set; }
        public int? BggGameId { get; set; }
        public Guid? GameId { get; set; }
    }
}
