@page "/create"
@using DesliderClaude.Core.Models
@using DesliderClaude.Core.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IGameNightService GameNights
@inject IBggImportService Bgg
@inject INightNameGenerator NightNames
@inject NavigationManager Nav

<PageTitle>Create Game Night — DesliderClaude</PageTitle>

<div class="night-builder">
<section class="hero setup-hero">
    <span class="kicker">New game night</span>
    <h1 class="hero-title">A good night starts<br />with a few good games.</h1>
    <p class="hero-lede">
        Pick what’s on the table. Share one link. Let everyone have a say.
    </p>
</section>

<div class="form-card setup-card">
    <form method="post" @formname="create-night" @onsubmit="HandleAsync" data-enhance>
        <AntiforgeryToken />

        <div class="setup-heading"><span class="step-number">01</span><div><h2>Choose your games</h2><p>Browse your collection and add only the games you want to offer.</p></div></div>

        <fieldset class="fieldset">
            <legend class="visually-hidden">Add games</legend>

            <section class="bgg-search" aria-labelledby="bgg-search-title">
                <h2 id="bgg-search-title">Find a game on BGG</h2>
                <p class="filter-help">Search for a title, then choose the game you mean. No library import needed.</p>
                <label for="bgg-search">Game name on BGG</label>
                <div class="inline-row">
                    <input id="bgg-search" type="search" name="Form.SearchQuery" value="@Form?.SearchQuery" maxlength="100" placeholder="e.g. Cascadia" />
                    <button type="submit" name="Form.Action" value="search-bgg" class="btn btn-ghost">Search BGG</button>
                </div>
                <p class="filter-help"><a href="https://boardgamegeek.com/browse/boardgame" target="_blank" rel="noopener noreferrer">Browse BoardGameGeek ↗</a></p>
                @if (_searchError is not null)
                {
                    <p class="text-danger" role="alert">@_searchError</p>
                }
                @if (_searched)
                {
                    <input type="hidden" name="Form.Searched" value="true" />
                    <div class="search-results-heading"><h3>BGG results</h3><button type="submit" name="Form.Action" value="clear-search" class="btn btn-ghost btn-sm">Clear search</button></div>
                    @if (_searchResults.Count == 0 && _searchError is null)
                    {
                        <p class="filter-help" role="status">No games found. Try another title, browse BGG, or add a name below.</p>
                    }
                    <ul class="bgg-search-results">
                        @foreach (var game in _searchResults)
                        {
                            var added = _candidates.Where((c, i) => _selected[i]).Any(c => c.BggGameId == game.BggGameId || string.Equals(c.Name, game.Name, StringComparison.OrdinalIgnoreCase));
                            <li class="bgg-search-row">
                                <button type="submit" name="Form.SearchGameId" value="@game.BggGameId" class="library-game unstyled" disabled="@added" aria-label="@($"Add {game.Name} from BGG")">
                                    @if (!string.IsNullOrEmpty(game.ThumbnailUrl))
                                    {
                                        <img class="candidate-thumb" src="@game.ThumbnailUrl" alt="" referrerpolicy="no-referrer" loading="lazy" />
                                    }
                                    <span class="candidate-main"><span class="candidate-name">@game.Name</span><span class="candidate-meta">@FormatRange(game.MinPlayers, game.MaxPlayers) players · @FormatRange(game.MinPlayTimeMinutes, game.MaxPlayTimeMinutes) min · BGG #@game.BggGameId</span></span>
                                    <span class="add-game-label" aria-hidden="true">@(added ? "Added ✓" : "＋ Add")</span>
                                </button>
                                <a class="bgg-detail-link" href="@($"https://boardgamegeek.com/boardgame/{game.BggGameId}")" target="_blank" rel="noopener noreferrer" aria-label="@($"Open {game.Name} on BGG")">Open on BGG ↗</a>
                                <input type="hidden" name="Form.SearchResultIds" value="@game.BggGameId" />
                            </li>
                        }
                    </ul>
                }
            </section>

            <label for="add-text">Add a single game</label>
            <div class="inline-row">
                <input id="add-text" name="Form.NewTextGame" value="@Form?.NewTextGame" maxlength="200"
                       placeholder="e.g. Terraforming Mars" />
                <button type="submit" name="Form.Action" value="add-text" class="btn btn-ghost">+ Add</button>
            </div>

            @if (_imports.Count > 0)
            {
                <label for="add-import" style="margin-top: var(--s-4);">Add a BGG library</label>
                <div class="inline-row">
                    <select id="add-import" name="Form.ImportToAdd">
                        <option value="">Pick a library…</option>
                        @foreach (var imp in _imports)
                        {
                            <option value="@imp.Id">@imp.Name — @imp.GameCount games</option>
                        }
                    </select>
                    <button type="submit" name="Form.Action" value="add-import" class="btn btn-ghost">Browse library</button>
                </div>
                <p class="subtle" style="font-size: 0.75rem; margin-top: 4px;">
                    Browsing a library doesn’t add any games to your night. Pick them below.
                </p>
            }
            else
            {
                <p class="subtle" style="margin-top: var(--s-3);">
                    Have a BoardGameGeek collection? <a href="/account/libraries">Connect your library →</a>
                    You can also add games by name above.
                </p>
            }
        </fieldset>

        <section class="night-shortlist" aria-labelledby="shortlist-title">
            <div class="shortlist-heading"><h2 id="shortlist-title">Games for this night</h2><span class="candidate-count">@(_selected.Count(x => x) == 1 ? "1 game" : $"{_selected.Count(x => x)} games") in this night</span></div>
            @if (!_selected.Any(x => x))
            {
                <div class="setup-empty"><span aria-hidden="true">＋</span><p>Your list starts empty. Add a game by name, or choose one from your library below.</p></div>
            }
            else
            {
                <ul class="shortlist">
                    @for (var i = 0; i < _candidates.Count; i++)
                    {
                        if (!_selected[i]) continue;
                        var c = _candidates[i];
                        <li class="shortlist-row">
                            @if (!string.IsNullOrEmpty(c.ThumbnailUrl))
                            {
                                <img class="candidate-thumb" src="@c.ThumbnailUrl" alt="" referrerpolicy="no-referrer" loading="lazy" />
                            }
                            <span class="candidate-main"><strong class="candidate-name">@c.Name</strong><span class="candidate-meta">@(c.IsManual ? "Added by you" : $"{FormatRange(c.MinPlayers, c.MaxPlayers)} players · {FormatRange(c.MinPlayTime, c.MaxPlayTime)} min")</span></span>
                            <button type="submit" name="Form.RemoveIndex" value="@i" class="btn btn-ghost btn-sm" aria-label="@($"Remove {c.Name} from this night")">Remove</button>
                        </li>
                    }
                </ul>
            }
            <p class="filter-help">Only games in this list will be offered for voting. Add at least two.</p>
        </section>

        @if (_candidates.Any(c => !c.IsManual))
        {
            <section class="library-browser" aria-labelledby="library-title">
                <h2 id="library-title">Available games</h2>
                <p class="filter-help">Tap a game to add it to your night.</p>
                <details class="game-filters" open="@(!string.IsNullOrWhiteSpace(Form?.MinPlayers) || !string.IsNullOrWhiteSpace(Form?.MaxPlayTime))">
                    <summary>Narrow it down <span class="subtle">optional</span></summary>
                    <div class="filter-grid">
                        <div>
                            <label for="f-players">How many players?</label>
                            <input id="f-players" name="Form.MinPlayers" type="number" min="1" max="99" value="@Form?.MinPlayers" placeholder="Any number" />
                        </div>
                        <div>
                            <label for="f-time">Up to how many minutes?</label>
                            <input id="f-time" name="Form.MaxPlayTime" type="number" min="1" max="999" value="@Form?.MaxPlayTime" placeholder="Any length" />
                        </div>
                    </div>
                    <p class="subtle filter-help">Filters help you browse. Games already added to your night stay in your list above.</p>
                    <div class="btn-row">
                        <button type="submit" name="Form.Action" value="filter" class="btn btn-ghost btn-sm">Apply filters</button>
                        <button type="submit" name="Form.Action" value="clear-filters" class="btn btn-ghost btn-sm">Clear filters</button>
                    </div>
                </details>
                <p class="available-count">@_visibleCount games available</p>
                @if (_visibleCount == 0)
                {
                    <p class="filter-help">No more games match these filters. Clear the filters to browse the rest of your library.</p>
                }
                <ul class="candidate-list">
                    @for (var i = 0; i < _candidates.Count; i++)
                    {
                        var c = _candidates[i];
                        if (c.IsManual) continue;
                        <li class="candidate-row" hidden="@(_selected[i] || !IsVisible(c))">
                            <button type="submit" name="Form.AddIndex" value="@i" class="library-game unstyled" aria-label="@($"Add {c.Name} to this night")">
                                @if (!string.IsNullOrEmpty(c.ThumbnailUrl))
                                {
                                    <img class="candidate-thumb" src="@c.ThumbnailUrl" alt="" referrerpolicy="no-referrer" loading="lazy" />
                                }
                                <span class="candidate-main"><span class="candidate-name">@c.Name</span><span class="candidate-meta">@FormatRange(c.MinPlayers, c.MaxPlayers) players · @FormatRange(c.MinPlayTime, c.MaxPlayTime) min</span></span>
                                <span class="add-game-label" aria-hidden="true">＋ Add</span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }

        @for (var i = 0; i < _candidates.Count; i++)
        {
            var c = _candidates[i];
            @* Keep the library and shortlist state across enhanced form posts. *@
            @if (_selected[i])
            {
                <input type="hidden" name="Form.SelectedIndexes" value="@i" />
            }
            <input type="hidden" name="Form.CandNames" value="@c.Name" />
            <input type="hidden" name="Form.CandBggIds" value="@c.BggGameId" />
            <input type="hidden" name="Form.CandImages" value="@(c.ImageUrl ?? string.Empty)" />
            <input type="hidden" name="Form.CandThumbs" value="@(c.ThumbnailUrl ?? string.Empty)" />
            <input type="hidden" name="Form.CandManuals" value="@(c.IsManual ? "1" : "0")" />
            <input type="hidden" name="Form.CandMinP" value="@(c.MinPlayers?.ToString() ?? string.Empty)" />
            <input type="hidden" name="Form.CandMaxP" value="@(c.MaxPlayers?.ToString() ?? string.Empty)" />
            <input type="hidden" name="Form.CandMinT" value="@(c.MinPlayTime?.ToString() ?? string.Empty)" />
            <input type="hidden" name="Form.CandMaxT" value="@(c.MaxPlayTime?.ToString() ?? string.Empty)" />
            <input type="hidden" name="Form.CandRecs" value="@string.Join(",", c.RecommendedFor)" />
        }

        <div class="night-details">
            <div class="setup-heading"><span class="step-number">02</span><div><h2>Make it yours</h2><p>A name helps friends find the right night.</p></div></div>
            <label for="night-name">Night name</label>
            <input id="night-name" name="Form.Name" value="@(string.IsNullOrEmpty(Form?.Name) ? _defaultName : Form!.Name)"
                   maxlength="200" placeholder="Friday boardgames" autocomplete="off" required />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-danger" role="alert">@_error</p>
        }
        @if (!string.IsNullOrEmpty(_notice))
        {
            <p class="text-ok" role="status">@_notice</p>
        }

        <div class="create-bar">
            <div><strong>@_selected.Count(x => x) games selected</strong><span>Next: invite your friends. No account needed to vote.</span></div>
            <button type="submit" name="Form.Action" value="create" class="btn btn-primary" disabled="@(_selected.Count(x => x) < 2)">Create night →</button>
        </div>
        <a class="setup-back" href="/">Back to your nights</a>
    </form>

</div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [CascadingParameter] public Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromForm] public CreateFormModel? Form { get; set; }

    private IReadOnlyList<BggImportView> _imports = Array.Empty<BggImportView>();
    private List<Candidate> _candidates = new();
    private List<bool> _selected = new();
    private int _visibleCount;
    private string? _error;
    private string? _notice;
    private string _defaultName = string.Empty;
    private IReadOnlyList<BggCandidateGame> _searchResults = Array.Empty<BggCandidateGame>();
    private bool _searched;
    private string? _searchError;

    protected override async Task OnInitializedAsync()
    {
        _defaultName = NightNames.Generate();

        var uid = await GetUserIdAsync();
        if (uid is not null)
        {
            _imports = await Bgg.ListForUserAsync(uid.Value);
        }

        RehydrateCandidatesFromForm();
        _searched = Form?.Searched == true;
        if (_searched)
        {
            var results = new List<BggCandidateGame>();
            try
            {
                foreach (var id in (Form?.SearchResultIds ?? Array.Empty<int>()).Where(id => id > 0).Distinct().Take(20))
                    results.Add(await Bgg.GetGameAsync(id));
                _searchResults = results;
            }
            catch (Exception ex) when (IsBggFailure(ex))
            {
                _searchError = "BGG results couldn’t be loaded. Search again, or add a game by name below.";
            }
        }
        RecountVisibility();
    }

    private async Task HandleAsync()
    {
        _error = null;
        _notice = null;
        var uid = await GetUserIdAsync();
        if (uid is null) return;

        if (Form?.SearchGameId is int searchId)
        {
            try
            {
                AddBggCandidate(await Bgg.GetGameAsync(searchId));
            }
            catch (Exception ex) when (IsBggFailure(ex))
            {
                _searchError = "That BGG game couldn’t be loaded. Try another result, or add its name below.";
            }
            RecountVisibility();
            return;
        }

        // Individual game actions take precedence over the other form buttons.
        if (!string.IsNullOrEmpty(Form?.RemoveIndex) && int.TryParse(Form.RemoveIndex, out var ri)
            && ri >= 0 && ri < _candidates.Count)
        {
            if (_candidates[ri].IsManual)
            {
                _candidates.RemoveAt(ri);
                _selected.RemoveAt(ri);
            }
            else
            {
                _selected[ri] = false;
            }
            RecountVisibility();
            return;
        }

        if (int.TryParse(Form?.AddIndex, out var addIndex) && addIndex >= 0 && addIndex < _candidates.Count)
        {
            _selected[addIndex] = true;
            RecountVisibility();
            return;
        }

        switch (Form?.Action)
        {
            case "search-bgg":
                await SearchBggAsync();
                break;
            case "clear-search":
                _searchResults = Array.Empty<BggCandidateGame>();
                _searched = false;
                _searchError = null;
                if (Form is not null) Form.SearchQuery = string.Empty;
                break;
            case "add-text":
                AddManual(Form.NewTextGame);
                if (Form is not null) Form.NewTextGame = string.Empty;
                break;
            case "add-import":
                if (Guid.TryParse(Form?.ImportToAdd, out var importId))
                {
                    await AddImportAsync(uid.Value, importId);
                    if (Form is not null) Form.ImportToAdd = string.Empty;
                }
                break;
            case "clear-filters":
                if (Form is not null)
                {
                    Form.MinPlayers = Form.MaxPlayTime = string.Empty;
                }
                break;
            case "filter":
                _notice = "Library filters updated. Your night’s games are unchanged.";
                break;
            case "create":
                await CreateAsync(uid.Value);
                return;
        }

        RecountVisibility();
    }

    private void AddManual(string? text)
    {
        var names = (text ?? string.Empty)
            .Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (names.Count == 0)
        {
            _error = "Type a game name first.";
            return;
        }

        var existing = _candidates.Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var added = 0;
        foreach (var n in names)
        {
            if (existing.Contains(n))
            {
                var index = _candidates.FindIndex(c => string.Equals(c.Name, n, StringComparison.OrdinalIgnoreCase));
                if (!_selected[index])
                {
                    _selected[index] = true;
                    added++;
                }
                continue;
            }
            _candidates.Add(new Candidate(n, 0, null, null, true, null, null, null, null, Array.Empty<int>()));
            _selected.Add(true);
            existing.Add(n);
            added++;
        }

        _notice = added == 0
            ? "Already on the list."
            : added == 1 ? "Added 1 game." : $"Added {added} games.";
    }

    private async Task AddImportAsync(Guid userId, Guid importId)
    {
        var games = await Bgg.ListCandidatesAsync(userId, new[] { importId });
        if (games.Count == 0)
        {
            _error = "That library has no games to import.";
            return;
        }

        var knownBgg = _candidates.Where(c => c.BggGameId > 0).Select(c => c.BggGameId).ToHashSet();
        var knownNames = _candidates.Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var added = 0;
        foreach (var g in games)
        {
            if (knownBgg.Contains(g.BggGameId) || knownNames.Contains(g.Name)) continue;
            var recs = g.RecommendedPlayerCounts
                .Where(v => v.Kind != BggPlayerCountKind.NotRecommended)
                .Select(v => v.Count)
                .Distinct()
                .OrderBy(n => n)
                .ToList();

            var candidate = new Candidate(
                g.Name, g.BggGameId, g.ImageUrl, g.ThumbnailUrl,
                IsManual: false,
                g.MinPlayers, g.MaxPlayers, g.MinPlayTimeMinutes, g.MaxPlayTimeMinutes,
                recs);

            _candidates.Add(candidate);
            _selected.Add(false);
            knownBgg.Add(g.BggGameId);
            knownNames.Add(g.Name);
            added++;
        }

        _notice = added == 0
            ? "That library is ready to browse below."
            : $"Ready to browse {added} games. Add the ones you want to play.";
    }

    private async Task CreateAsync(Guid userId)
    {
        var name = Form?.Name?.Trim();
        if (string.IsNullOrEmpty(name))
        {
            _error = "Give the night a name.";
            return;
        }

        var chosen = new List<GameCandidate>();
        for (var i = 0; i < _candidates.Count; i++)
        {
            if (!_selected[i]) continue;
            var c = _candidates[i];
            if (c.BggGameId > 0)
            {
                try
                {
                    var game = await Bgg.GetGameAsync(c.BggGameId);
                    chosen.Add(new GameCandidate(game.Name, game.BggGameId, game.ImageUrl, game.ThumbnailUrl));
                }
                catch (Exception ex) when (IsBggFailure(ex))
                {
                    _error = "A BGG game couldn’t be loaded. Remove it and try adding it again, or add its name manually.";
                    return;
                }
            }
            else
            {
                chosen.Add(new GameCandidate(c.Name, null, c.ImageUrl, c.ThumbnailUrl));
            }
        }

        chosen = chosen
            .GroupBy(c => c.Name.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();

        if (chosen.Count < 2)
        {
            _error = "Pick at least two games — otherwise there's nothing to swipe.";
            return;
        }

        var night = await GameNights.CreateAsync(name, null, chosen, userId);
        Nav.NavigateTo($"/night/{night.ShareCode}/host");
    }

    private async Task SearchBggAsync()
    {
        _searched = true;
        _searchError = null;
        _searchResults = Array.Empty<BggCandidateGame>();
        var query = Form?.SearchQuery?.Trim() ?? string.Empty;
        if (query.Length < 2 || query.Length > 100)
        {
            _searchError = "Enter a game title between 2 and 100 characters. You can also add a name below.";
            return;
        }
        try
        {
            _searchResults = await Bgg.SearchGamesAsync(query);
        }
        catch (Exception ex) when (IsBggFailure(ex))
        {
            _searchError = "BGG search is unavailable right now. Try again, or add a game by name below.";
        }
    }

    private void AddBggCandidate(BggCandidateGame game)
    {
        var candidate = new Candidate(game.Name, game.BggGameId, game.ImageUrl, game.ThumbnailUrl, false,
            game.MinPlayers, game.MaxPlayers, game.MinPlayTimeMinutes, game.MaxPlayTimeMinutes,
            game.RecommendedPlayerCounts.Where(v => v.Kind != BggPlayerCountKind.NotRecommended).Select(v => v.Count).Distinct().Order().ToArray());
        var index = _candidates.FindIndex(c => c.BggGameId == game.BggGameId || string.Equals(c.Name, game.Name, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
        {
            _candidates.Add(candidate);
            _selected.Add(true);
        }
        else
        {
            _candidates[index] = candidate;
            _selected[index] = true;
        }
    }

    private static bool IsBggFailure(Exception ex) => ex is InvalidOperationException or ArgumentException or HttpRequestException or TaskCanceledException or System.Xml.XmlException;

    private bool IsVisible(Candidate c)
    {
        if (c.IsManual) return true; // Always show manual rows — per product rule.
        if (Form is null) return true;

        if (int.TryParse(Form.MinPlayers, out var players) && players > 0)
            if (c.MinPlayers is null || c.MaxPlayers is null || c.MinPlayers > players || c.MaxPlayers < players) return false;

        if (int.TryParse(Form.MaxPlayTime, out var minutes) && minutes > 0)
            if (c.MaxPlayTime is null || c.MaxPlayTime > minutes) return false;

        return true;
    }

    private void RecountVisibility()
    {
        _visibleCount = 0;
        for (var i = 0; i < _candidates.Count; i++)
        {
            if (_selected[i] || _candidates[i].IsManual || !IsVisible(_candidates[i])) continue;
            _visibleCount++;
        }
    }

    private void RehydrateCandidatesFromForm()
    {
        if (Form is null) return;

        var names = Form.CandNames ?? Array.Empty<string>();
        var bggIds = Form.CandBggIds ?? Array.Empty<string>();
        var images = Form.CandImages ?? Array.Empty<string>();
        var thumbs = Form.CandThumbs ?? Array.Empty<string>();
        var manuals = Form.CandManuals ?? Array.Empty<string>();
        var minP = Form.CandMinP ?? Array.Empty<string>();
        var maxP = Form.CandMaxP ?? Array.Empty<string>();
        var minT = Form.CandMinT ?? Array.Empty<string>();
        var maxT = Form.CandMaxT ?? Array.Empty<string>();
        var recs = Form.CandRecs ?? Array.Empty<string>();

        var n = names.Length;
        _candidates = new List<Candidate>(n);
        _selected = new List<bool>(n);
        var selectedSet = (Form.SelectedIndexes ?? Array.Empty<string>())
            .Select(s => int.TryParse(s, out var i) ? i : -1)
            .ToHashSet();

        for (var i = 0; i < n; i++)
        {
            _candidates.Add(new Candidate(
                Name: names[i],
                BggGameId: i < bggIds.Length && int.TryParse(bggIds[i], out var id) ? id : 0,
                ImageUrl: i < images.Length && !string.IsNullOrEmpty(images[i]) ? images[i] : null,
                ThumbnailUrl: i < thumbs.Length && !string.IsNullOrEmpty(thumbs[i]) ? thumbs[i] : null,
                IsManual: i < manuals.Length && manuals[i] == "1",
                MinPlayers: i < minP.Length && int.TryParse(minP[i], out var a) ? a : null,
                MaxPlayers: i < maxP.Length && int.TryParse(maxP[i], out var b) ? b : null,
                MinPlayTime: i < minT.Length && int.TryParse(minT[i], out var c) ? c : null,
                MaxPlayTime: i < maxT.Length && int.TryParse(maxT[i], out var d) ? d : null,
                RecommendedFor: i < recs.Length
                    ? recs[i].Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(s => int.TryParse(s, out var r) ? r : 0)
                        .Where(r => r > 0)
                        .ToArray()
                    : Array.Empty<int>()));
            _selected.Add(selectedSet.Contains(i));
        }
    }

    private async Task<Guid?> GetUserIdAsync()
    {
        if (AuthState is null) return null;
        var state = await AuthState;
        return state.User.GetUserId();
    }

    private static string FormatRange(int? min, int? max)
    {
        if (min is null && max is null) return "?";
        if (min == max) return min!.Value.ToString();
        if (min is null) return $"≤{max}";
        if (max is null) return $"≥{min}";
        return $"{min}–{max}";
    }

    public sealed record Candidate(
        string Name,
        int BggGameId,
        string? ImageUrl,
        string? ThumbnailUrl,
        bool IsManual,
