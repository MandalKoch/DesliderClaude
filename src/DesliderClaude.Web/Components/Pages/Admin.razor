@page "/admin"
@using DesliderClaude.Core.Models
@using DesliderClaude.Core.Services
@inject IAdminService AdminSvc

<PageTitle>Admin — DesliderClaude</PageTitle>

<section class="hero">
    <span class="kicker kicker-gold">Admin</span>
    <h1 class="hero-title">Control deck.</h1>
</section>

@if (_overview is null)
{
    <p class="subtle">Loading…</p>
}
else
{
    <div class="admin-stats">
        <div class="admin-stat"><span class="admin-stat-num">@_overview.UserCount</span><span class="admin-stat-label">Users</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.NightCount</span><span class="admin-stat-label">Nights</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.OpenNightCount</span><span class="admin-stat-label">Open nights</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.ClosedNightCount</span><span class="admin-stat-label">Closed nights</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.VoterCount</span><span class="admin-stat-label">Night voters</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.SwipeCount</span><span class="admin-stat-label">Night swipes</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.SwipesLast24h</span><span class="admin-stat-label">Night swipes / 24h</span></div>
    </div>

    <h2 class="kicker">Gathering activity</h2>
    <div class="admin-stats gathering-stats">
        <div class="admin-stat"><span class="admin-stat-num">@_overview.GatheringCount</span><span class="admin-stat-label">Gatherings</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.OpenGatheringCount</span><span class="admin-stat-label">Voting open</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.ClosedGatheringCount</span><span class="admin-stat-label">Voting closed</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.GatheringMemberCount</span><span class="admin-stat-label">Memberships</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.GatheringGameCount</span><span class="admin-stat-label">Gathering games</span></div>
        <div class="admin-stat"><span class="admin-stat-num">@_overview.GatheringVoteCount</span><span class="admin-stat-label">Gathering votes</span></div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="text-danger">@_error</p>
    }

    <nav class="admin-tabs" aria-label="Admin sections">
        <a href="/admin?tab=nights" class="admin-tab @(_activeTab == "nights" ? "is-active" : null)">
            Nights <span class="admin-tab-count">@_nights.Count</span>
        </a>
        <a href="/admin?tab=gatherings" class="admin-tab @(_activeTab == "gatherings" ? "is-active" : null)">
            Gatherings <span class="admin-tab-count">@_gatherings.Count</span>
        </a>
        <a href="/admin?tab=users" class="admin-tab @(_activeTab == "users" ? "is-active" : null)">
            Users <span class="admin-tab-count">@_users.Count</span>
        </a>
        <a href="/admin?tab=games" class="admin-tab @(_activeTab == "games" ? "is-active" : null)">
            Top night games <span class="admin-tab-count">@_topGames.Count</span>
        </a>
    </nav>

    @if (_activeTab == "users")
    {
        @if (_users.Count == 0)
        {
            <p class="subtle">No registered users yet.</p>
        }
        else
        {
            <div class="admin-table-scroll" role="region" aria-label="Admin records" tabindex="0">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Sign-in</th>
                        <th class="right">Nights hosted</th>
                        <th class="right">Nights voted in</th>
                        <th class="right">Night swipes</th>
                        <th>Registered</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _users)
                    {
                        <tr>
                            <td>@u.Username</td>
                            <td>
                                @if (u.HasPassword)
                                {
                                    <span class="nights-badge voter" title="Registered with a local password">Local</span>
                                }
                                @foreach (var p in u.ExternalProviders)
                                {
                                    <span class="nights-badge host" title="Signs in with @p">@p</span>
                                }
                                @if (!u.HasPassword && u.ExternalProviders.Count == 0)
                                {
                                    <span class="subtle">—</span>
                                }
                            </td>
                            <td class="right">@u.NightsHosted</td>
                            <td class="right">@u.NightsVotedIn</td>
                            <td class="right">@u.SwipeCount</td>
                            <td>@u.CreatedAt.ToString("MMM d, HH:mm")</td>
                            <td>
                                <div class="admin-row-actions">
                                    <details class="admin-inline-form">
                                        <summary class="btn btn-ghost btn-sm" role="button">Set password</summary>
                                        <form method="post" @formname="@($"set-pwd-{u.Id}")" @onsubmit="() => SetPasswordAsync(u.Id)" data-enhance>
                                            <AntiforgeryToken />
                                            <input type="password" name="Pwd.Value" autocomplete="new-password" required placeholder="New password" />
                                            <button type="submit" class="btn btn-cyan btn-sm">Save</button>
                                        </form>
                                    </details>
                                    @if (u.Id == _currentUserId)
                                    {
                                        <span class="subtle">you</span>
                                    }
                                    else
                                    {
                                        <form method="post" @formname="@($"del-user-{u.Id}")" @onsubmit="() => DeleteUserAsync(u.Id)" data-enhance>
                                            <AntiforgeryToken />
                                            <button type="submit" class="btn btn-ghost btn-sm"
                                                    data-confirm-message="@($"Delete user “{u.Username}”? Their hosted nights stay but lose the owner link.")"
                                                    onclick="return confirm(this.dataset.confirmMessage);">✕</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
    else if (_activeTab == "gatherings")
    {
        @if (_gatherings.Count == 0)
        {
            <p class="subtle">No gatherings yet.</p>
        }
        else
        {
            <div class="admin-table-scroll" role="region" aria-label="Gatherings" tabindex="0">
            <table class="admin-table gatherings-table"><thead><tr><th>Name</th><th>Host</th><th>Status</th><th class="right">Games</th><th class="right">Members</th><th class="right">Votes</th><th>Created</th></tr></thead><tbody>
                @foreach (var gathering in _gatherings)
                {
                    <tr><td><a class="admin-row-link" href="/admin/gatherings/@gathering.ShareCode">@gathering.Name</a><div class="admin-row-links"><a class="admin-row-sub" href="/gathering/@gathering.ShareCode">Public gathering</a></div></td><td>@(gathering.HostUsername ?? "—")</td><td><span class="nights-badge @(gathering.IsVotingClosed ? "closed" : "warn")">@(gathering.IsVotingClosed ? "Closed" : "Open")</span></td><td class="right">@gathering.GameCount</td><td class="right">@gathering.MemberCount</td><td class="right">@gathering.VoteCount</td><td>@gathering.CreatedAt.ToString("MMM d, HH:mm")</td></tr>
                }
            </tbody></table>
            </div>
        }
    }
    else if (_activeTab == "games")
    {
        @if (_topGames.Count == 0)
        {
            <p class="subtle">No swipes cast yet.</p>
        }
        else
        {
            <ol class="ranking-list">
                @foreach (var g in _topGames)
                {
                    <li>
                        <span class="ranking-name">@g.Name</span>
                        <span class="ranking-votes">
                            <span class="yes">+@g.YesCount</span>
                            <span class="no">−@g.NoCount</span>
                        </span>
                    </li>
                }
            </ol>
        }
    }
    else
    {
        @if (_nights.Count == 0)
        {
            <p class="subtle">No nights yet.</p>
        }
        else
        {
            <div class="admin-table-scroll" role="region" aria-label="Admin records" tabindex="0">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Host</th>
                        <th class="right">Games</th>
                        <th class="right">Voters</th>
                        <th class="right">Night swipes</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in _nights)
                    {
                        <tr>
                            <td>
                                <a href="/admin/nights/@n.ShareCode" class="admin-row-link" title="Admin view (manage voters)">@n.Name</a>
                                <div class="admin-row-links">
                                    <a href="/night/@n.ShareCode" class="admin-row-sub" title="Voter entry">@n.ShareCode</a>
                                    <span class="subtle">·</span>
                                    <a href="/night/@n.ShareCode/host" class="admin-row-sub" title="Host dashboard (works for the creator)">host</a>
                                    <span class="subtle">·</span>
                                    <a href="/night/@n.ShareCode/winner" class="admin-row-sub" title="Winner / ranking">winner</a>
                                </div>
                            </td>
                            <td>@(n.HostUsername ?? "—")</td>
                            <td class="right">@n.GameCount</td>
                            <td class="right">@n.VoterCount</td>
                            <td class="right">@n.SwipeCount</td>
                            <td>
                                @if (n.IsClosed)
                                {
                                    <span class="nights-badge closed">Closed</span>
                                }
                                else
                                {
                                    <span class="nights-badge warn">Open</span>
                                }
                            </td>
                            <td>@n.CreatedAt.ToString("MMM d, HH:mm")</td>
                            <td>
                                @if (!n.IsClosed)
                                {
                                    <form method="post" @formname="@($"close-night-{n.Id}")" @onsubmit="() => CloseNightAsync(n.Id)" data-enhance>
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-ghost btn-sm" title="Close voting"
                                                data-confirm-message="@($"Close voting on “{n.Name}”? Locks the ranking and flips every voter to the winner.")"
                                                onclick="return confirm(this.dataset.confirmMessage);">Close</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" @formname="@($"reopen-night-{n.Id}")" @onsubmit="() => ReopenNightAsync(n.Id)" data-enhance>
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn btn-ghost btn-sm" title="Re-open voting">Re-open</button>
                                    </form>
                                }
                                <form method="post" @formname="@($"del-night-{n.Id}")" @onsubmit="() => DeleteNightAsync(n.Id)" data-enhance>
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Delete night"
                                            data-confirm-message="@($"Delete “{n.Name}”? This removes all its games, voters, and swipes.")"
                                            onclick="return confirm(this.dataset.confirmMessage);">✕</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
}

@code {
    [CascadingParameter] public Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromForm] public PasswordFormModel? Pwd { get; set; }

    public sealed class PasswordFormModel
    {
        public string Value { get; set; } = string.Empty;
    }

    private AdminOverview? _overview;
    private IReadOnlyList<AdminUserRow> _users = Array.Empty<AdminUserRow>();
    private IReadOnlyList<AdminGatheringRow> _gatherings = Array.Empty<AdminGatheringRow>();
    private IReadOnlyList<AdminNightRow> _nights = Array.Empty<AdminNightRow>();
    private IReadOnlyList<GamePopularityRow> _topGames = Array.Empty<GamePopularityRow>();
    private Guid? _currentUserId;
    private string? _error;

    private string _activeTab => Tab switch
    {
        "users" => "users",
        "games" => "games",
        "gatherings" => "gatherings",
        _ => "nights",
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _currentUserId = state.User.GetUserId();
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _overview = await AdminSvc.GetOverviewAsync();
        _users = await AdminSvc.ListUsersAsync();
        _nights = await AdminSvc.ListNightsAsync();
        _gatherings = await AdminSvc.ListGatheringsAsync();
        _topGames = await AdminSvc.TopGamesAsync();
    }

    // Handlers intentionally don't Nav.NavigateTo — Blazor SSR re-renders the
    // page after the form POST, and skipping the redirect lets enhanced
    // navigation preserve scroll position on the admin deck.
    private async Task DeleteNightAsync(Guid nightId)
    {
        _error = null;
        try { await AdminSvc.DeleteNightAsync(nightId); }
        catch (Exception ex) { _error = ex.Message; }
        await LoadAsync();
    }

    private async Task CloseNightAsync(Guid nightId)
    {
        _error = null;
        try { await AdminSvc.CloseNightAsync(nightId); }
        catch (Exception ex) { _error = ex.Message; }
        await LoadAsync();
    }

    private async Task ReopenNightAsync(Guid nightId)
    {
        _error = null;
        try { await AdminSvc.ReopenNightAsync(nightId); }
        catch (Exception ex) { _error = ex.Message; }
        await LoadAsync();
    }

    private async Task DeleteUserAsync(Guid userId)
    {
        _error = null;
        if (userId == _currentUserId) { _error = "You can't delete yourself."; return; }
        try { await AdminSvc.DeleteUserAsync(userId); }
        catch (Exception ex) { _error = ex.Message; }
        await LoadAsync();
    }

    private async Task SetPasswordAsync(Guid userId)
    {
        _error = null;
        var pwd = Pwd?.Value;
        if (string.IsNullOrEmpty(pwd)) { _error = "Enter a new password."; return; }
        try { await AdminSvc.SetUserPasswordAsync(userId, pwd); }
        catch (Exception ex) { _error = ex.Message; }
        await LoadAsync();
    }
}
